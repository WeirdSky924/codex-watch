[Unit]
Description=Codex Watch Guardian (%i)
After=default.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Use the installer-owned wrapper directly; PATH may contain another watchdog.
ExecStart=%h/.local/bin/codex-watch-guardian --session %i
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
